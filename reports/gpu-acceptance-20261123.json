      "changes": [
        {
          "path": "src/grurec.py",
          "diff": "--- src/grurec.py\n+++ src/grurec.py\n@@ -1,4 +1,4 @@\n-\"\"\"Small GRU next-item model for checking the existing adapter's portability.\"\"\"\n+\"\"\"GRU next-item model with self-attention for temporal relevance modeling.\"\"\"\n from __future__ import annotations\n \n import torch\n@@ -8,13 +8,18 @@\n \n class GRURec(nn.Module):\n     def __init__(self, num_items: int, max_length: int, hidden_size: int = 64,\n-                 num_layers: int = 1, dropout: float = 0.4):\n+                 num_layers: int = 1, dropout: float = 0.4, nhead: int = 4, attn_dropout: float = 0.3):\n         super().__init__()\n         self.max_length = max_length\n         self.item_embedding = nn.Embedding(num_items + 1, hidden_size, padding_idx=0)\n         self.dropout = nn.Dropout(dropout)\n         self.encoder = nn.GRU(hidden_size, hidden_size, num_layers=num_layers,\n                               batch_first=True, dropout=dropout if num_layers > 1 else 0)\n+        # Self-attention layer over GRU outputs to weight temporal relevance\n+        self.attention = nn.MultiheadAttention(\n+            embed_dim=hidden_size, num_heads=nhead, dropout=attn_dropout, batch_first=True\n+        )\n+        self.attention_dropout = nn.Dropout(attn_dropout)\n         self.output_norm = nn.LayerNorm(hidden_size)\n         self.item_bias = nn.Parameter(torch.zeros(num_items + 1))\n \n@@ -26,10 +31,15 @@\n         positions = (torch.arange(histories.shape[1], device=histories.device)[None, :]\n                      + histories.shape[1] - lengths[:, None]) % histories.shape[1]\n         compact = histories.gather(1, positions)\n-        packed = pack_padded_sequence(self.dropout(self.item_embedding(compact)),\n-                                      lengths.cpu(), batch_first=True, enforce_sorted=False)\n-        _, hidden = self.encoder(packed)\n-        return self.output_norm(hidden[-1])\n+        embedded = self.dropout(self.item_embedding(compact))\n+        # Unpacked encoding preserves all time-step outputs for attention\n+        output_all, _ = self.encoder(embedded)\n+        # Attention mask marks padded positions as False (True = masked)\n+        mask = (compact == 0).bool()\n+        # Self-attention over all GRU outputs → dynamic weighting of historical states\n+        attn_out, _ = self.attention(output_all, output_all, output_all, key_padding_mask=mask)\n+        attn_out = self.attention_dropout(attn_out)\n+        return self.output_norm(attn_out)\n \n     def catalog_logits(self, user_states: torch.Tensor) -> torch.Tensor:\n         return user_states @ self.item_embedding.weight[1:].t() + self.item_bias[1:]\n",
