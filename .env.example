# Copy to .reclab/agent.env and replace placeholders. Never store private-key contents here.
RECLAB_MODEL=your-agent-model
OPENAI_API_KEY=your-api-key
# Optional for compatible endpoints:
# OPENAI_BASE_URL=https://your-provider.example/v1
# TAVILY_API_KEY=your-search-key

SSH_HOST=connect.example.com
SSH_PORT=22
SSH_USER=root
# Absolute local paths; Windows paths are supported through --windows-ssh in WSL.
SSH_KEY_PATH=C:/Users/DT/.ssh/id_ed25519_gpu
SSH_KNOWN_HOSTS_PATH=C:/Users/DT/.ssh/known_hosts
SSH_REMOTE_ROOT=/root/autodl-tmp/reclab-agent-runs/ssh-tmux
SSH_PYTHON=/root/miniconda3/bin/python
